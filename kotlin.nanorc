## \uFDFD
##                    \u0648\u0627\u0630\u0643\u0631 \u0631\u0628\u0651\u0643
##       \u0643\u062A\u0628\u0647 \u0639\u0628\u062F \u0627\u0644\u0646\u0651\u0648\u0631
##             \u0661\u0664\u0664\u0667 \u0634\u0639\u0628\u0627\u0646 \u0661\u0669

syntax kotlin "\.kt$"
comment "//"

# Types
color brightcyan "\<([A-Z][0-9a-z]*)+\??"

# Keywords
color green "catch|class|import|lateinit|package|this|try|super"
color green "\<((private|protected|public|companion)?[[:blank:]])*object\>"
color green "\<((override|private|protected|public)?[[:blank:]])*(val|var|fun)\>"
color green "\<(break|continue|if|else|for|in|when|do|while|to|return)\>"

# Constants
color brightred "\<true|false|null\>"
color brightred "\<[A-Z_][0-9A-Z_]*\>"
color brightred "\<[0-9]+\.?[0-9]*f?\>"
color brightred "\<0x[0-9A-F]+\>"
color brightred "'([^\\']|\\(t|b|n|r|'|\"|\\|\$|u[0-9A-F]{4}))'"

# Declarations
color magenta "\<[a-z][0-9a-zA-Z]*:"

# Strings
color blue "<[^=    ]*>" ""(\\.|[^"])*""

# Interpolates
color yellow "\$\{[^\}]*\}"

# Comments
color red "//.*"
color red start="/\*" end="\*/"

# Trailing
color ,green "[[:space:]]+$"
